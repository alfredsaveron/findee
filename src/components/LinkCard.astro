---
import Icon from './Icon.astro';

interface Props {
  title: string;
  subtitle: string;
  url: string;
  icon: string;
  color: string;
}

const { title, subtitle, url, icon, color } = Astro.props;
---
<a href={url} target="_blank" rel="noopener noreferrer">
  <div class="find-box" style={`--color: ${color}`}>
    <div class="icon-box">
      <Icon name={icon} />
    </div>
    <div>
      <h5>{title}</h5>
      <span>{subtitle}</span>
    </div>
  </div>
</a>
